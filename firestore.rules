rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // يقرأها تطبيق المحتوى بدون تسجيل دخول — لا تحتوي روابط بث حقيقية أبداً.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /channels/{channelId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // رسائل "تواصل معنا" و"الإبلاغ عن رابط معطوب" من تطبيق المحتوى.
    // أي مستخدم (بدون تسجيل دخول) يقدر يُنشئ رسالة جديدة فقط — لا يقدر
    // يقرأ أو يعدّل أو يحذف رسائل غيره. القراءة/الإدارة محصورة على
    // حساب لوحة التحكم المسجّل دخوله.
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // روابط m3u8 الحقيقية. ممنوعة القراءة من تطبيق المحتوى وتطبيق المشغل تماماً —
    // المشغل يحصل عليها فقط عبر Cloud Function (getStreamUrl) التي تتجاوز هذه
    // القواعد باستخدام صلاحيات Admin SDK. القراءة/الكتابة هنا مسموحة فقط
    // لحساب لوحة التحكم المسجّل دخوله، لعرض/تعديل الرابط الحالي بسهولة.
    match /privateStreams/{channelId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // مباريات اليوم المخزّنة من Cloud Function (syncMatchesHourly /
    // refreshMatches) بعد جلبها من API-Football. القراءة مفتوحة لتطبيق
    // المحتوى بدون تسجيل دخول، والكتابة ممنوعة تماماً من أي عميل — لا
    // حتى لوحة التحكم — لأن الدالتين تستخدمان Admin SDK الذي يتجاوز هذه
    // القواعد أصلاً.
    match /matches_daily/{dateId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
